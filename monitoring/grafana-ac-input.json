{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "id": null,
  "uid": "anern-pi30-acinput",
  "title": "Anern PI30 — AC input / Grid diagnostics",
  "tags": [
    "anern",
    "pi30",
    "venus-os",
    "grid"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": true,
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Scope and data quality",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "**Inverter AC input voltage and frequency only.** The driver has no validated Grid W/A/kWh measurement. Input voltage does not prove the grid relay is closed or power is being imported. Device-local L1 is not the household phase assignment. No protective thresholds are implied.\n\nUnknown or stale telemetry is omitted. Gaps are not zero. Fresh data requires observing a change in the driver's UpdateIndex. Experimental monitoring; verify independently."
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "AC input voltage",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "anern_ac_input_voltage_volts{job=\"anern-grid\"}",
          "legendFormat": "{{instance}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "volt",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "spanNulls": false,
            "showPoints": "auto",
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "AC input frequency",
      "gridPos": {
        "x": 12,
