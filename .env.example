# Examples only. Programs do not automatically load .env files.
# grid_exporter.py reads CERBO_SSH_TARGET from its environment.
CERBO_SSH_TARGET=root@CERBO_HOST
# Documentation helpers only; not read by the exporter.
GRAFANA_URL=https://GRAFANA_HOST
PROMETHEUS_URL=https://PROMETHEUS_HOST
# Never commit real credentials. Prefer SSH agent + existing Grafana login.
